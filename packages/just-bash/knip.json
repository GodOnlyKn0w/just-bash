{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/world/virtual-world.ts",
    "src/world/shell-worker.ts"
  ],
  "project": [
    "src/**/*.ts"
  ],
  "ignore": [
    "src/**/*.test.ts",
    "src/spec-tests/**",
    "src/banned-patterns-test.ts"
  ],
  "ignoreBinaries": [
    "tsx"
  ],
  "rules": {
    "unlisted": "off",
    "unresolved": "off",
    "optionalPeerDependencies": "off",
    "types": "off"
  }
}
